{
	admin localhost:2019
	default_sni localhost
	log default {
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
				}
			}
		}
	}
}

(vigil-routes) {
	route {
		@sensitive path_regexp sensitive `(?i)(^|/)(\.env([./]|$)|\.(git|svn|hg)(/|$)|\.(htaccess|htpasswd|DS_Store)(/|$))`
		respond @sensitive 403

		@internal path /internal /internal/*
		handle @internal {
			respond 404
		}

		@waf path /api/* /otlp/* /config/tls/ca
		handle @waf {
			reverse_proxy waf:8080 {
				# Caddy is the public trust boundary; never accept a client-chosen IP.
				header_up X-Forwarded-For {remote_host}
				header_up -Forwarded
			}
		}

		handle {
			root * /usr/share/caddy
			try_files {path} /index.html
			file_server
		}
	}
}

# self-hosted: every name is signed by caddy's local CA
localhost, vigil.localhost, host.docker.internal {
	tls internal
	import vigil-routes
}
