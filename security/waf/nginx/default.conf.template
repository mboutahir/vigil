# Caddy terminates TLS; this container is an internal HTTP WAF.
server_tokens ${SERVER_TOKENS};
more_set_headers 'Server: ${SERVER_HEADER}';
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen ${PORT} default_server;
    server_name ${SERVER_NAME};
    location = /internal { return 404; }
    location ^~ /internal/ { return 404; }
    # Match decoded paths, including nested files, before API proxying.
    location ~* (^|/)(\.env([./]|$)|\.(git|svn|hg)(/|$)|\.(htaccess|htpasswd|DS_Store)(/|$)) {
        return 403;
    }
    # JWT is supplied in ?token=; never put it in Nginx access logs.
    location = /api/alerts/ws {
        access_log off;
        client_max_body_size 13m;
        include includes/proxy_backend.conf;
    }
    # caddy's public root certificate (copied to the shared volume by the proxy entrypoint), never a key
    location = /config/tls/ca {
        alias /etc/vigil/ca/root.crt;
        default_type application/x-pem-file;
        add_header Content-Disposition 'attachment; filename="vigil-ca.crt"' always;
        add_header Cache-Control no-store always;
    }
    # EventSource sends its JWT in the query string.
    location ~ ^/api/telemetry/(?:logs|metrics|traces)/live$ {
        access_log off;
        client_max_body_size 13m;
        include includes/proxy_backend.conf;
    }
    # Buffering is disabled for all API responses, including Ask AI streams.
    location /api/ {
        client_max_body_size 13m;
        include includes/proxy_backend.conf;
    }
    location /otlp/ {
        client_max_body_size 13m;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $vigil_collector http://telemetry-collector:4318;
        proxy_set_header Proxy "";
        rewrite ^/otlp(/.*)$ $1 break;
        proxy_pass $vigil_collector;
    }
    location / { return 404; }
    include includes/location_common.conf;
}
